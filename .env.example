# ==========================================================
# Atlas Multi-Agent Research Assistant - Environment Variables
# ==========================================================

# LLM Provider Selection: 'gemini', 'openai', 'ollama', or 'simulation_offline'
ATLAS_LLM_PROVIDER=gemini

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily AI Search API Key (Optional - Fallback to DuckDuckGo/Wikipedia is built-in)
TAVILY_API_KEY=
